{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Backend API (Express)",
      "cwd": "backend",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set NODE_OPTIONS=--use-system-ca&& npm run dev"],
      "port": 3001
    },
    {
      "name": "Frontend (Vite)",
      "cwd": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173
    },
    {
      "name": "Mobile (Expo)",
      "cwd": "mobile-frontend",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start"],
      "port": 8081
    }
  ]
}
