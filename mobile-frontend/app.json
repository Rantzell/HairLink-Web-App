{
  "expo": {
    "name": "Hair Link",
    "slug": "Hair Link",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "web": {},
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "HairLink uses your camera to let you preview wig styles on yourself in AR Try-On."
        }
      ]
    ],
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hairlink.app"
    },
    "android": {
      "package": "com.hairlink.app",
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFE4EE"
      }
    }
  }
}
