{
  "expo": {
    "name": "Hair Link",
    "slug": "hairlink",
    "owner": "rammiiee",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "web": {},
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "HairLink uses your camera to let you preview wig styles on yourself in AR Try-On."
        }
      ]
    ],
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hairlink.app"
    },
    "android": {
      "package": "com.hairlink.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFE4EE"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "da067742-7e15-4cdc-988a-25e0df39a83d"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/da067742-7e15-4cdc-988a-25e0df39a83d"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
