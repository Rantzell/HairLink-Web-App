{
  "expo": {
    "name": "Hair Link",
    "slug": "hairlink",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "web": {},
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "HairLink uses your camera to let you preview wig styles on yourself in AR Try-On."
        }
      ],
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "HairLink uses your camera for AR hair try-on.",
          "enableFrameProcessors": false
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#FF1493"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hairlink.app"
    },
    "android": {
      "package": "com.hairlink.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFE4EE"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "da067742-7e15-4cdc-988a-25e0df39a83d"
      }
    }
  }
}
