# Copy this to .env and fill in the real secrets. Do NOT commit your real .env.

# Supabase PostgreSQL — Connection Pooling (pooler) — used at runtime by the app
# Example host contains `pooler.supabase.com`
DATABASE_URL="postgresql://<db_user>:<password>@<your-project>.pooler.supabase.com:5432/postgres"

# Supabase PostgreSQL — Direct connection (non-pooler) — used for migrations/CLI
# Get from Supabase Dashboard → Settings → Database → Connection string (URI)
DIRECT_URL="postgresql://<db_user>:<password>@<direct-host>.supabase.co:5432/postgres"

# Supabase Project
SUPABASE_URL="https://<your-project>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# Supabase JWT Secret — used by backend to verify Supabase-issued JWTs
SUPABASE_JWT_SECRET="<jwt-secret>"

# Legacy fallback (no longer used for primary auth)
JWT_SECRET="hairlink_secret_key_2026_secure_random_string_8234912384"

# Server
PORT=3001

# Frontend (Vite)
VITE_API_URL=http://localhost:3001
VITE_SUPABASE_URL=https://<your-project>.supabase.co
# Anon (public) key — safe to expose in browser (different from service_role above)
VITE_SUPABASE_ANON_KEY="<anon-key>"
