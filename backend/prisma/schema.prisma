generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                Int                 @id @default(autoincrement())
  name              String
  firstName         String?             @map("first_name")
  lastName          String?             @map("last_name")
  email             String              @unique
  emailVerifiedAt   DateTime?           @map("email_verified_at")
  password          String
  role              String              @default("donor")
  country           String?
  region            String?
  postalCode        String?             @map("postal_code")
  age               Int?
  gender            String?
  phone             String?
  bio               String?
  profile_photo_url String?
  isActive          Boolean             @default(true) @map("is_active")
  referredBy        String?             @map("referred_by")
  referralCode      String?             @map("referral_code")
  onesignalId       String?             @map("onesignal_id")
  rememberToken     String?             @map("remember_token")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  communityComments CommunityComment[]
  likedPosts        CommunityPostLike[]
  communityPosts    CommunityPost[]
  donations         Donation[]
  hairRequests      HairRequest[]
  monetaryDonations MonetaryDonation[]
  wigProductions    WigProduction[]     @relation("WigmakerTasks")

  @@map("users")
}

model Donation {
  id                Int             @id @default(autoincrement())
  userId            Int             @map("user_id")
  reference         String          @unique
  hairLength        String?         @map("hair_length")
  hairColor         String?         @map("hair_color")
  treatedHair       Boolean         @default(false) @map("treated_hair")
  address           String?
  reason            String?
  status            String          @default("Submitted")
  certificateNo     String?         @map("certificate_no")
  photoFront        String?         @map("photo_front")
  photoSide         String?         @map("photo_side")
  donorDeliveryLink String?         @map("donor_delivery_link")
  receivedWigAt     DateTime?       @map("received_wig_at")
  dropoffLocation   String?         @map("dropoff_location")
  appointmentAt     DateTime?       @map("appointment_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  user              User            @relation(fields: [userId], references: [id])
  wigProductions    WigProduction[]

  @@map("donations")
}

model HairRequest {
  id                   Int             @id @default(autoincrement())
  userId               Int             @map("user_id")
  reference            String          @unique
  contactNumber        String?         @map("contact_number")
  gender               String?
  story                String?
  status               String          @default("Pending")
  medicalCertificate   String?         @map("medical_certificate")
  diagnosisPhoto       String?         @map("diagnosis_photo")
  recipientPhoto       String?         @map("recipient_photo")
  additionalPhoto      String?         @map("additional_photo")
  documents            Json?
  notes                String?
  wigLength            String?         @map("wig_length")
  wigColor             String?         @map("wig_color")
  wigReceivedAt        DateTime?       @map("wig_received_at")
  deliveryTrackingLink String?         @map("delivery_tracking_link")
  appointmentAt        DateTime?       @map("appointment_at")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")
  user                 User            @relation(fields: [userId], references: [id])
  wigProductions       WigProduction[]

  @@map("hair_requests")
}

model WigProduction {
  id            Int          @id @default(autoincrement())
  taskCode      String       @unique @map("task_code")
  wigmakerId    Int          @map("wigmaker_id")
  donationId    Int?         @map("donation_id")
  hairRequestId Int?         @map("hair_request_id")
  targetLength  String?      @map("target_length")
  targetColor   String?      @map("target_color")
  status        String       @default("assigned")
  dueDate       DateTime?    @map("due_date")
  deliveryLink  String?      @map("delivery_link")
  preview_photo String?
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  donation      Donation?    @relation(fields: [donationId], references: [id])
  hairRequest   HairRequest? @relation(fields: [hairRequestId], references: [id])
  wigmaker      User         @relation("WigmakerTasks", fields: [wigmakerId], references: [id])

  @@map("wig_productions")
}

model CommunityPost {
  id        String              @id @default(uuid())
  userId    Int                 @map("user_id")
  content   String
  imageUrl  String?             @map("image_url")
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")
  comments  CommunityComment[]
  likedBy   CommunityPostLike[]
  user      User                @relation(fields: [userId], references: [id])

  @@map("community_posts")
}

model CommunityComment {
  id        String             @id @default(uuid())
  postId    String             @map("post_id")
  userId    Int                @map("user_id")
  content   String?
  imageUrl  String?            @map("image_url")
  parentId  String?            @map("parent_id")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @map("updated_at")
  parent    CommunityComment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies   CommunityComment[] @relation("CommentReplies")
  post      CommunityPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [userId], references: [id])

  @@map("community_comments")
}

model CommunityPostLike {
  id              String        @id
  communityPostId String        @map("community_post_id")
  userId          Int           @map("user_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  post            CommunityPost @relation(fields: [communityPostId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id])

  @@unique([communityPostId, userId])
  @@map("community_post_likes")
}

model StatusHistory {
  id            Int         @id @default(autoincrement())
  trackableId   Int         @map("trackable_id")
  trackableType String      @map("trackable_type")
  status        String
  notes         String?
  metadata      Json?
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@index([trackableId, trackableType])
  @@map("status_histories")
}

model MonetaryDonation {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  name            String?
  amount          Decimal  @db.Decimal(10, 2)
  currency        String   @default("PHP")
  paymentMethod   String?  @map("payment_method")
  referenceNumber String?  @map("reference_number")
  proofPath       String?  @map("proof_path")
  status          String   @default("Submitted")
  remarks         String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  user            User     @relation(fields: [userId], references: [id])

  @@map("monetary_donations")
}

model Event {
  id                Int      @id @default(autoincrement())
  title             String
  date              DateTime
  description       String?
  location          String?
  status            String   @default("Upcoming")
  participantsCount Int      @default(0) @map("participants_count")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("events")
}

model HaircareArticle {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  image_url String?
  author    String?
  category  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("haircare_articles")
}

model HaircareVideo {
  id          Int      @id @default(autoincrement())
  title       String
  url         String
  thumbnail   String?
  description String?
  category    String?
  duration    String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("haircare_videos")
}

model Partnership {
  id          Int      @id @default(autoincrement())
  name        String
  type        String?
  contact     String?
  email       String?
  description String?
  logo_url    String?
  status      String   @default("Active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("partnerships")
}
